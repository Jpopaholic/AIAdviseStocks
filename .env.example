# AIAdviseStocks 選填環境變數範例 (Vercel 或本地皆無須必填，LLM API Key 由前端 BYOK 輸入)
PYTHON_ENV=production
PORT=8000
LOG_LEVEL=INFO
TAIWAN_STOCK_TIMEZONE=Asia/Taipei
DEFAULT_AUTO_SELECT_BOARD=core_top20
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_AUTO_SELECT_COUNT=20
KLINE_HISTORY_DAYS=90
STOCK_CACHE_TTL_SECONDS=900

